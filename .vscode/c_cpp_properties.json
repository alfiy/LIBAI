{
    "version": 4,
    "configurations": [
        {
            "name": "linux-x64-uefi",
            "compilerPath": "/usr/bin/gcc",
            "intelliSenseMode": "linux-gcc-x64",
            "cStandard": "c11",
            "cppStandard": "c++17",
            "includePath": [
                "${workspaceFolder}",
                "${workspaceFolder}/include",
                "${workspaceFolder}/boot",
                "${workspaceFolder}/kernel",
                "/usr/include/efi",
                "/usr/include/efi/x86_64",
                "/usr/include/efi/protocol"
            ],
            "defines": [
                "__x86_64__",
                "HAVE_USE_MS_ABI"
            ],
            "browse": {
                "path": [
                    "${workspaceFolder}",
                    "/usr/include/efi"
                ],
                "limitSymbolsToIncludedHeaders": true
            }
        }
    ]
}
